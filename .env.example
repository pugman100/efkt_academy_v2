# PostgreSQL (Neon Lakebase Postgres). `neon env pull --file .env` fills these from the
# linked branch. DATABASE_URL is the pooled URL used by the app; DATABASE_URL_UNPOOLED is
# the direct URL Prisma uses for migrations. For a local Postgres, set both to the same URL.
DATABASE_URL="postgresql://postgres@localhost:5432/efkt_academy"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/efkt_academy"

# Neon Object Storage (S3-compatible "uploads" bucket, declared in neon.ts). Filled by
# `neon env pull`.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# Public base URL, used in invitation and password reset links
APP_URL="http://localhost:3000"

# Transactional email via Resend (https://resend.com). Leave empty to log emails
# to the server console and the EmailOutbox table instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="EFKT Academy <academy@efkt.com>"

# Shared secret for the scheduled job endpoint (/api/cron) — invitation reminders,
# invitation expiry and scheduled news publishing.
CRON_SECRET="change-me"
