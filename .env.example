# PostgreSQL connection string
DATABASE_URL="postgresql://postgres@localhost:5432/efkt_academy"

# Public base URL, used in invitation and password reset links
APP_URL="http://localhost:3000"

# Transactional email via Resend (https://resend.com). Leave empty to log emails
# to the server console and the EmailOutbox table instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="EFKT Academy <academy@efkt.com>"

# Shared secret for the scheduled job endpoint (/api/cron) — invitation reminders,
# invitation expiry and scheduled news publishing.
CRON_SECRET="change-me"
