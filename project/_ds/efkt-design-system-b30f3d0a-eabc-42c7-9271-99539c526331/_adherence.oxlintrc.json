      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|coral)$/]",
        "message": "<StatCard> tone must be one of 'navy' | 'coral'."
