        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|coral|outline|onPhoto)$/]",
        "message": "<Tag> tone must be one of 'default' | 'coral' | 'outline' | 'onPhoto'."
